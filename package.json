{
  "name": "anortir-callbacks",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply anortir-callbacks --local",
    "db:migrate:remote": "wrangler d1 migrations apply anortir-callbacks --remote"
